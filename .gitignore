# Generated by XcodeGen — never commit, regenerate with `xcodegen`
*.xcodeproj

# Xcode
xcuserdata/
DerivedData/
build/
*.xcresult

# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/

# Third-party app screenshots used only as private proof-read source material.
docs/sources/**/*.jpg
docs/sources/**/*.jpeg
docs/sources/**/*.png

# Android / Gradle (build/ is already ignored above)
.gradle/
.kotlin/
local.properties
.idea/
*.iml

# Signing keys never belong in the repo (#92): CI decodes the upload key from
# a secret into a temp file, and local builds point at it outside the tree.
*.jks
*.keystore
*.p12
