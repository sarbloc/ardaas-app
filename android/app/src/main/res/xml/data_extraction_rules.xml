<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device transfer on Android 12+ (API 31+). Mirrored for older
  versions by backup_rules.xml; keep the two in step (BackupRulesTest).

  An allowlist: only what the user made is copied — saved Ardaas (Room,
  ardaas.db, with its journal/WAL) and the Reader's display preferences.
  Everything else stays on the device, including the ~600 MB translation
  model, which lives in noBackupFilesDir and is never backed up anyway, and
  the cache directories, which Android never backs up.

  This is the Android equivalent of the iOS promise that data leaves the
  device only "through your own encrypted device backups": Google's Auto
  Backup (switched on or off by the user in Android settings) and a
  device-to-device transfer to a new phone.

  Encryption: Google encrypts every backup; with a screen lock (Android 9+)
  it is end-to-end encrypted. End-to-end is deliberately NOT required here
  (no disableIfNoEncryptionCapabilities / requireFlags): standard iCloud
  Backup is not end-to-end either, and the privacy policy states exactly
  this. Requiring it would silently drop backups for users without a screen
  lock, and cannot be enforced on API 26-27 at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="ardaas.db" />
        <include domain="sharedpref" path="reader.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ardaas.db" />
        <include domain="sharedpref" path="reader.xml" />
    </device-transfer>
</data-extraction-rules>
